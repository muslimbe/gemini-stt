# Timezone for log timestamps (IANA name)
TZ=Asia/Tashkent

# Gemini API key
GEMINI_API_KEY=

# Telegram bot (the `bot` service only). Its own bot from @BotFather, not tars's:
# one token can't be polled by two processes.
BOT_TOKEN=

# Admin Telegram user ID (integer); manages the allowlist with /allow, /deny, /list
ADMIN_USER_ID=

# The rest have defaults, uncomment to override.

# Gemini model (gemini-3.5-flash, gemini-3.1-pro-preview needs billing)
#GEMINI_MODEL=gemini-3.5-flash

# Max simultaneous jobs per service; the rest queue (integer)
#MAX_CONCURRENT=4

# Host path of tars's data/attachments (read by docker compose, not the service)
#TARS_ATTACHMENTS_DIR=../tars/data/attachments
