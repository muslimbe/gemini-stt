# Timezone for log timestamps (IANA name)
TZ=Asia/Tashkent

# Gemini API key
GEMINI_API_KEY=

# The rest have defaults, uncomment to override.

# Gemini model (gemini-3.5-flash, gemini-3.1-pro-preview needs billing)
#GEMINI_MODEL=gemini-3.5-flash

# Max simultaneous jobs; the rest queue (integer)
#MAX_CONCURRENT=4

# Host path of tars's data/attachments (read by docker compose, not the service)
#TARS_ATTACHMENTS_DIR=../tars/data/attachments
